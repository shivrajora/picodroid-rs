<?xml version="1.0" encoding="utf-8"?>
<!--
  A launcher row for an app with an icon: the icon, then the label on one line, cut with an
  ellipsis, on a 40-pixel focusable band that spans the display. LauncherActivity inflates it and
  sets the icon and the text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="4dp"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:focusable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF" />
</LinearLayout>
