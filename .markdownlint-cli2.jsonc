{
  "globs": [
    "README.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "CONTRIBUTING.md",
    "docs/README.md",
    "docs/designs/README.md",
    "docs/gaps.md",
    "docs/scorecard.md",
    "docs/devlog.md",
    "docs/decisions.md",
    "docs/designs/agent-driving-2026-10.md",
    ".claude/rules/*.md",
    "crates/*/CLAUDE.md",
    "platforms/*/CLAUDE.md",
    "sdk/CLAUDE.md",
    "scripts/CLAUDE.md",
    "system-apps/CLAUDE.md",
    "LICENSING.md",
    "CLA.md",
    "crates/jvm/README.md",
    "crates/compat/README.md",
    "tools/*/README.md",
    "sdk/shrink-maps/README.md"
  ],
  "ignores": [
    "third_party/**",
    "node_modules/**",
    "build/**",
    "target/**",
    "website/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD029": false,
    "MD033": false,
    "MD041": false,
    "MD046": { "style": "fenced" }
  }
}
