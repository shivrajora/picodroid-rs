**/*.rs.bk
.#*
.gdb_history
Cargo.lock
target/
# Per-triple build directories used by `scripts/pre-commit`'s parallel lanes.
# Cargo serializes concurrent invocations that share one target dir, so each
# lane gets its own. Safe to `rm -rf` at any time.
target-thumbv6m/
target-thumbv8m/

# Downloaded tooling (google-java-format and ktfmt JARs, fetched on demand by
# scripts/format_java.sh / format_kotlin.sh). Everything else under
# third_party/ is a submodule or vendored source and is tracked.
third_party/*.jar

# Build artifacts (compiled classes, packaged APKs)
build/

# Gradle wrapper cache, daemon state, config-cache entries
.gradle/

# Node/npm (markdownlint-cli2 dev dependency)
node_modules/

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# editor files
.vscode/*
!.vscode/*.md
!.vscode/*.svd
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
# Local WiFi credentials (user-supplied, never committed)
/.wifi-creds.env
__pycache__/

# Kotlin survey (tools/kotlin-survey) generated dumps
tools/kotlin-survey/out/
