**/*.rs.bk
.#*
.gdb_history
Cargo.lock
# Also holds `scripts/pre-commit`'s per-triple lane directories
# (target/lane-thumbv6m, target/lane-thumbv8m): cargo serializes concurrent
# invocations that share one target dir, so each lane gets its own.
target/

# Downloaded tooling (google-java-format and ktfmt JARs, fetched on demand by
# scripts/format_java.sh / format_kotlin.sh). Everything else under
# third_party/ is a submodule or vendored source and is tracked.
third_party/*.jar

# Build artifacts (compiled classes, packaged APKs)
build/

# Gradle wrapper cache, daemon state, config-cache entries
.gradle/

# Kotlin Gradle plugin session state
.kotlin/

# Node/npm: scripts/lint-md/ (markdownlint-cli2) and website/ (Astro)
node_modules/

# Claude Code local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# editor files
.vscode/*
!.vscode/*.md
!.vscode/*.svd
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
!.vscode/settings.json
# Local WiFi credentials (user-supplied, never committed)
/.wifi-creds.env
__pycache__/

# Kotlin survey (tools/kotlin-survey) generated dumps
tools/kotlin-survey/out/
