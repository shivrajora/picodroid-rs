#!/usr/bin/env bash
# Picodroid pre-commit gate.
#
# Two tiers, both parallel:
#
#   ./scripts/pre-commit          fast (default, and what the git hook runs).
#                                 The source-tree guards that exist nowhere
#                                 else plus the formatters the changed files
#                                 implicate. Seconds; no cargo build.
#   ./scripts/pre-commit --full   the legs neither CI nor the nightlies run:
#                                 the legacy-handle-cast hatch and opt-in
#                                 mem-diag / sched-diag firmware, the
#                                 pico_enviro_mon_w lint, the shrunk-image
#                                 name check and the binary-size ratchet.
#                                 Minutes; run it before cutting a release.
#
# Everything else is deliberately NOT here. .github/workflows/ci_checks.yml
# runs the board clippy legs, rp2040+rp2350 in debug and release, test.sh in
# both shrink modes, every example APK and its API contract, both formatters,
# the same source guards (scripts/check-source-guards.sh) and a 18-app sim
# smoke that includes the three langsuites; the 3 AM sim-run.sh runs the whole
# hil-tests.conf matrix (the qa_* apps, benchmark, blinky, the mem-diag /
# sched-diag soaks, the size ratchet) and the 4 AM hil-fleet.sh runs it on
# hardware. Pushing does not wait for --full: CI and the nightlies are the
# regression gates.
#
# Stages are grouped into lanes that run concurrently. Each cargo lane gets its
# own CARGO_TARGET_DIR because cargo serializes concurrent invocations that
# share one build directory, and the lanes are split by target triple so they
# would not have shared artifacts anyway. Gradle is the one thing that must not
# run twice at once (lib.sh::gradle_lock_run).
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT_DIR="$REPO_ROOT/scripts"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

# ---------------------------------------------------------------- arguments

TIER=fast
SERIAL=0
LIST_ONLY=0
SINCE_REF=""

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

  --fast          Change-scoped tier (default, and what the git hook runs):
                  the local-only source guards plus the formatters the
                  changed files implicate. Seconds.
  --full          The legs neither CI nor the nightlies cover: the staged
                  and opt-in firmware builds, the shrunk-image check, the
                  size ratchet. Minutes. Run before cutting a release.
  --since <ref>   Compute the changed set against <ref> instead of the index
                  or working tree.
  --serial        Run lanes one at a time, streaming to stdout. Same stage
                  set as a parallel run; use it to debug a failure.
  --list          Print the stages that would run, then exit.
  --clean         Remove the per-lane build directories and exit.
  -h, --help      This message.

Environment:
  PICODROID_PRECOMMIT_JOBS=1   same as --serial.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --fast)    TIER=fast; shift ;;
    --full)    TIER=full; shift ;;
    --since)   SINCE_REF="$2"; shift 2 ;;
    --serial)  SERIAL=1; shift ;;
    --list)    LIST_ONLY=1; shift ;;
    --clean)   rm -rf "$REPO_ROOT/target/lane-thumbv6m" "$REPO_ROOT/target/lane-thumbv8m"
               echo "Removed target/lane-thumbv6m/ and target/lane-thumbv8m/."; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done

[[ "${PICODROID_PRECOMMIT_JOBS:-}" == "1" ]] && SERIAL=1

# ---------------------------------------------------------- change detection
#
# Git sets GIT_INDEX_FILE for hooks, which is how we know to look at the index
# rather than the working tree: a hook must judge what is being committed, not
# what happens to be lying around unstaged.

changed_files() {
  # Testing hook: a newline-separated file list stands in for git. Only the
  # scoping decision reads this -- it cannot make a selected stage pass.
  if [[ -n "${PICODROID_PRECOMMIT_FILES:-}" ]]; then
    printf '%s\n' "$PICODROID_PRECOMMIT_FILES"
  elif [[ -n "$SINCE_REF" ]]; then
    git -C "$REPO_ROOT" diff --name-only "$SINCE_REF" --
  elif [[ -n "${GIT_INDEX_FILE:-}" ]]; then
    git -C "$REPO_ROOT" diff --cached --name-only --
  else
    git -C "$REPO_ROOT" diff --name-only HEAD --
    git -C "$REPO_ROOT" ls-files --others --exclude-standard
  fi | sort -u
}

BUCKET_RUST=0
BUCKET_JVM=0
BUCKET_MD=0
BUCKET_SCRIPTS=0

classify_changes() {
  local f any=0
  while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    any=1
    # `case` globs match `/` too, so a bare *.rs covers every depth.
    case "$f" in
      *.rs|*Cargo.toml|*Cargo.lock|.cargo/config.toml|crates/build_support/*|\
      platforms/*.toml|platforms/*.h|platforms/*.x|third_party/*|\
      rust-toolchain*|.gitmodules)
        BUCKET_RUST=1 ;;
    esac
    case "$f" in
      *.java|*.kt|*.kts|*.gradle|gradle.properties|gradle/*|gradlew*|\
      sdk/*|examples/*|buildSrc/*|bench/parity/ratchet.toml)
        BUCKET_JVM=1 ;;
    esac
    case "$f" in
      *.md|website/*|.markdownlint*) BUCKET_MD=1 ;;
    esac
    case "$f" in
      scripts/*) BUCKET_SCRIPTS=1 ;;
    esac
  done < <(changed_files)

  # Nothing detected (clean tree, manual run) means we have no evidence about
  # what is safe to skip, so assume everything is in play.
  if [[ $any -eq 0 ]]; then
    BUCKET_RUST=1; BUCKET_JVM=1; BUCKET_MD=1
  fi
}

classify_changes

# --full is deliberately unscoped: it is the release-cut gate. A scripts/
# change no longer promotes to it -- the scripts bucket selects the checks
# that live under scripts/ (hil-tests.conf drift, the device-lock test), and
# CI runs everything else on push.
if [[ "$TIER" == full ]]; then
  BUCKET_RUST=1; BUCKET_JVM=1; BUCKET_MD=1; BUCKET_SCRIPTS=1
fi

# ------------------------------------------------------------------- stages
#
# Registry rows: name|lane|min-tier|buckets|label
# `min-tier` is the cheapest tier at which the stage runs; `buckets` is
# `always` or a comma-separated list, any one of which selects it.

STAGES=(
  "twins|guards|fast|always|shadow twins across platforms/ and picodroid-core"
  "cfg_gates|guards|fast|always|sim/family-rp cfg-gate hygiene"
  "jvm_env|guards|fast|always|apply_jvm_env propagation"
  # CI runs the drift check on every push (ci_checks.yml `linting`); locally
  # it matters when the conf itself, under scripts/, changed.
  "hil_conf|guards|fast|scripts|hil-tests.conf against the source tree"
  "device_lock|guards|fast|scripts|device-lock state machine (test-device-lock.sh)"
  "apk|guards|full|rust,jvm|helloworld APK (shared by every cargo lane)"

  "fmt_java|jvm|fast|jvm|Java formatting"
  "fmt_kotlin|jvm|fast|jvm|Kotlin formatting"
  "lint_md|jvm|fast|md|markdown lint"

  "fmt_rust|host|fast|rust|cargo fmt"
  "clippy_sim_memdiag|host|full|rust|clippy (sim + mem-diag)"
  "clippy_sim_scheddiag|host|full|rust|clippy (sim + sched-diag)"

  "clippy_rp2040_legacy_cast|arm6|full|rust|clippy (testbench_rp2040 + legacy-handle-cast)"
  "size_rp2040|arm6|full|rust,jvm|size lane (rp2040)"

  # Order is load-bearing. pico_enviro_mon_w is the only board whose
  # board.toml [jvm] block exports anything (gc_alloc_threshold = 128), and
  # that is a `rerun-if-env-changed` input to jvm/build.rs -- so every switch
  # into or out of it rebuilds pico-jvm and everything above it. Keeping it
  # last makes that one transition instead of two.
  "build_rp2350_memdiag|arm8|full|rust,jvm|build (rp2350 + mem-diag)"
  "build_rp2350w_scheddiag|arm8|full|rust,jvm|build (rp2350w + sched-diag)"
  "size_rp2350|arm8|full|rust,jvm|size lane (rp2350)"
  "shrink_image|arm8|full|rust,jvm|--shrink image carries no original Java name (rp2350 --release)"
  "clippy_enviro_w|arm8|full|rust|clippy (pico_enviro_mon_w)"

  # The nightly sim-run.sh ratchets every night on this machine's lockfile;
  # --full does it here so a release cut sees the number before it ships.
  "ratchet|epilogue|full|rust,jvm|binary-size ratchet"
)

LANE_ORDER=(guards jvm host arm6 arm8 epilogue)

bucket_selected() {
  case "$1" in
    always) return 0 ;;
  esac
  local b
  IFS=',' read -ra b <<< "$1"
  for one in "${b[@]}"; do
    case "$one" in
      rust)    [[ $BUCKET_RUST    -eq 1 ]] && return 0 ;;
      jvm)     [[ $BUCKET_JVM     -eq 1 ]] && return 0 ;;
      md)      [[ $BUCKET_MD      -eq 1 ]] && return 0 ;;
      scripts) [[ $BUCKET_SCRIPTS -eq 1 ]] && return 0 ;;
    esac
  done
  return 1
}

# lane -> space-separated selected stage names
declare -A LANE_STAGES=()
declare -A STAGE_LABEL=()
SELECTED_COUNT=0

for row in "${STAGES[@]}"; do
  IFS='|' read -r s_name s_lane s_tier s_buckets s_label <<< "$row"
  [[ "$s_tier" == full && "$TIER" != full ]] && continue
  bucket_selected "$s_buckets" || continue
  LANE_STAGES[$s_lane]="${LANE_STAGES[$s_lane]:-} $s_name"
  STAGE_LABEL[$s_name]="$s_label"
  SELECTED_COUNT=$((SELECTED_COUNT + 1))
done

# The ratchet compares whatever size logs the arm lanes produced; with none it
# has nothing to say.
if [[ -z "${LANE_STAGES[arm6]:-}${LANE_STAGES[arm8]:-}" ]]; then
  unset 'LANE_STAGES[epilogue]'
fi

# ------------------------------------------------------------------ context

JOBS_TOTAL="$(cpu_count)"
HOST_TARGET="$(host_target)"
# Deliberately NOT build/apks/helloworld.papk. That path is shared with
# sim.sh, test.sh and anyone else on this checkout, and it is the file the
# clippy legs embed, the flash gate links and the size ratchet measures -- a
# concurrent `sim.sh --app helloworld` would swap it mid-run and the ratchet
# would gate on someone else's build. This copy belongs to the run.
APK_PATH="$REPO_ROOT/build/apks/pre-commit/helloworld.papk"
# Every system app (system-apps/*: the launcher, settings) the multi-app
# firmware lanes link in, built once beside the app PAPK for the same
# reason — the colon-separated list build_system_apks takes as prebuilt.
SYSTEM_APK_PATHS=""
for system_app_dir in "$REPO_ROOT"/system-apps/*/; do
  [[ -f "$system_app_dir/PicodroidManifest.xml" ]] || continue
  SYSTEM_APK_PATHS="${SYSTEM_APK_PATHS:+$SYSTEM_APK_PATHS:}$REPO_ROOT/build/apks/pre-commit/$(basename "$system_app_dir").papk"
done

RUN_DIR="$REPO_ROOT/build/pre-commit/$(date -u '+%Y-%m-%dT%H%M%S')"
mkdir -p "$RUN_DIR/size"
# Keep the last few runs' logs for triage, drop the rest.
ls -1dt "$REPO_ROOT"/build/pre-commit/* 2>/dev/null | tail -n +6 | xargs -r rm -rf

# Per-lane build directories. cargo takes a lock on the whole build directory,
# so lanes that shared one would simply queue behind each other. Split by
# target triple, which is also the boundary at which they stop sharing
# artifacts. The host lane keeps target/ so day-to-day sim.sh / test.sh work
# still hits the warm cache; the ARM lanes nest under it (a target dir inside
# another is fine — cargo locks each one separately — and it keeps the repo
# root free of build directories, at the cost of `cargo clean` dropping them
# along with the host lane).
declare -A LANE_TARGET_DIR=(
  [host]="$REPO_ROOT/target"
  [arm6]="$REPO_ROOT/target/lane-thumbv6m"
  [arm8]="$REPO_ROOT/target/lane-thumbv8m"
)

# Split the job budget across the cargo lanes actually running, so four lanes
# do not each try to saturate the machine.
CARGO_LANES=0
for lane in host arm6 arm8; do
  [[ -n "${LANE_STAGES[$lane]:-}" ]] && CARGO_LANES=$((CARGO_LANES + 1))
done
if [[ $SERIAL -eq 1 || $CARGO_LANES -le 1 ]]; then
  JOBS="$JOBS_TOTAL"
else
  JOBS=$(( JOBS_TOTAL / CARGO_LANES ))
  [[ $JOBS -lt 2 ]] && JOBS=2
fi

# ------------------------------------------------------------ stage bodies
#
# Each is a plain function so --serial and the parallel driver run byte-for-byte
# the same commands.

# Both text-only guards live in scripts/check-source-guards.sh so the CI
# `guards` job runs byte-for-byte the same checks.
stage_twins()     { bash "$SCRIPT_DIR/check-source-guards.sh" --twins; }
stage_cfg_gates() { bash "$SCRIPT_DIR/check-source-guards.sh" --cfg-gates; }

stage_hil_conf() {
  if ! bash "$SCRIPT_DIR/check-hil-conf.sh"; then
    echo ""
    echo "ERROR: hil-tests.conf references apps or log tags that no longer"
    echo "       exist. Update the affected rows (or ALLOW_TAGS in"
    echo "       scripts/check-hil-conf.sh) so the nightly suites don't go"
    echo "       permanently red."
    return 1
  fi
}

stage_jvm_env() {
  if ! bash "$SCRIPT_DIR/test-jvm-env.sh"; then
    echo ""
    echo "ERROR: apply_jvm_env smoke test failed. The [jvm] board.toml parser"
    echo "       in scripts/lib.sh is not propagating values to the right"
    echo "       PICODROID_JVM_* env vars. Fix before committing."
    return 1
  fi
}

stage_device_lock() {
  if ! bash "$SCRIPT_DIR/test-device-lock.sh"; then
    echo ""
    echo "ERROR: device-lock state machine test failed (scripts/device-lock.sh,"
    echo "       lib.sh::require_device_lock). Every board script depends on it;"
    echo "       fix before committing."
    return 1
  fi
}

stage_apk() {
  # Built once, here, in the serial prologue: every cargo lane embeds it, and
  # PICODROID_APK_PATH is a `rerun-if-env-changed` build.rs input, so a stable
  # path is also what keeps the lanes from invalidating each other.
  # --strip-debug: this snapshot only ever feeds firmware lanes (the clippy
  # legs, the flash gate, the size ratchet), so it takes the device shape.
  # Without --keep-lines, so the debug-profile flash gate measures a PAPK
  # with no app line table (the SDK's rides in the firmware regardless);
  # helloworld's would be a few dozen bytes.
  bash "$SCRIPT_DIR/build-apk.sh" --app helloworld --strip-debug -o "$APK_PATH"
  # The system apps, for the same reason: every multi-app firmware lane
  # embeds them, and system-apps/*/build/ must not be raced either.
  local system_app_dir system_app
  for system_app_dir in "$REPO_ROOT"/system-apps/*/; do
    [[ -f "$system_app_dir/PicodroidManifest.xml" ]] || continue
    system_app="$(basename "$system_app_dir")"
    bash "$SCRIPT_DIR/build-apk.sh" --app "$system_app" --strip-debug \
      -o "$REPO_ROOT/build/apks/pre-commit/$system_app.papk"
  done
}

stage_fmt_java() {
  if ! bash "$SCRIPT_DIR/format_java.sh" check; then
    echo ""
    echo "ERROR: Java formatting check failed. Run './scripts/format_java.sh' to fix."
    return 1
  fi
}

stage_fmt_kotlin() {
  if ! bash "$SCRIPT_DIR/format_kotlin.sh" check; then
    echo ""
    echo "ERROR: Kotlin formatting check failed. Run './scripts/format_kotlin.sh' to fix."
    return 1
  fi
}

stage_lint_md() {
  if ! bash "$SCRIPT_DIR/lint-md.sh"; then
    echo ""
    echo "ERROR: Markdown lint failed. Run './scripts/lint-md.sh --fix' to"
    echo "       auto-fix, or './scripts/lint-md.sh' to see issues."
    echo "       If deps aren't installed yet: run '(cd scripts/lint-md && npm ci)'."
    return 1
  fi
}

stage_fmt_rust() {
  if ! cargo fmt -- --check; then
    echo ""
    echo "ERROR: Formatting check failed. Run 'cargo fmt' to fix, then re-stage your changes."
    return 1
  fi
}

# clippy_board <board> [extra-features]
clippy_board() {
  local board="$1" extra="${2:-}"
  resolve_board "$board"
  local features="$BOARD_FEATURE${extra:+,$extra}"
  # shellcheck disable=SC2086  # CARGO_PLUS is empty or a "+toolchain" override
  if ! PICODROID_APK_PATH="$APK_PATH" \
       cargo $CARGO_PLUS clippy \
         --manifest-path "$MANIFEST_DIR/Cargo.toml" \
         -p "$PACKAGE" --jobs "$JOBS" --target "$TARGET" --no-default-features \
         --features "$features" -- --deny=warnings; then
    echo ""
    echo "ERROR: Clippy check failed ($board${extra:+ + $extra}). Fix the warnings above."
    return 1
  fi
}

# The one board leg CI does not compile: pico_enviro_mon_w's board.toml is the
# only [jvm] block that exports anything (see the registry's ordering note).
stage_clippy_enviro_w() { clippy_board pico_enviro_mon_w; }

# The generational handle table (audit P1-9) became the default for every
# board on 2026-09-15, so every clippy/build leg here already compiles and
# links it. What nothing else compiles now is the arm it replaced: the raw
# pointer cast, kept one release behind `legacy-handle-cast` as the escape
# hatch. One leg on the tighter of the two widths keeps the hatch from
# rotting; drop this stage when the cast and its feature go.
stage_clippy_rp2040_legacy_cast() { clippy_board testbench_rp2040 legacy-handle-cast; }

# clippy on the host target. MANIFEST_DIR/PACKAGE/CARGO_PLUS come from a
# resolve_board call, which also fixes the JVM tunables the sim is linted with.
clippy_sim_features() {
  local features="$1"
  resolve_board testbench_rp2350
  # shellcheck disable=SC2086
  if ! PICODROID_APK_PATH="$APK_PATH" \
       cargo $CARGO_PLUS clippy \
         --manifest-path "$MANIFEST_DIR/Cargo.toml" \
         -p "$PACKAGE" --jobs "$JOBS" --target "$HOST_TARGET" --no-default-features \
         --features "$features" -- --deny=warnings; then
    echo ""
    echo "ERROR: Clippy check failed ($features). Fix the warnings above."
    return 1
  fi
}

# Keeps the opt-in memory diagnostics compiling and warning-clean
# (docs/memory-diagnostics.md); the firmware flash budget for mem-diag is
# checked by build_rp2350_memdiag.
stage_clippy_sim_memdiag() { clippy_sim_features "sim,board-testbench-rp2350,mem-diag"; }

# The scheduling monitor's host arm (docs/scheduling-diagnostics.md); the
# firmware side is build_rp2350w_scheddiag.
stage_clippy_sim_scheddiag() { clippy_sim_features "sim,board-testbench-rp2350,sched-diag"; }

# build_board <board> [--release] with PICODROID_EXTRA_FEATURES already set.
build_board() {
  PICODROID_PREBUILT_APK="$APK_PATH" PICODROID_PREBUILT_SYSTEM_APKS="$SYSTEM_APK_PATHS" \
    bash "$SCRIPT_DIR/build.sh" "$@"
}

stage_build_rp2350_memdiag() {
  # Proves the diagnostics firmware compiles + links (vPortGetHeapStats FFI,
  # thumb atomics discipline) and prints its flash cost. RP2040 + mem-diag is
  # a manual opt-in only — it sits ~0.1 KB under the 896K program region.
  if ! PICODROID_EXTRA_FEATURES=mem-diag \
       build_board --board testbench_rp2350 --app helloworld; then
    echo ""
    echo "ERROR: rp2350 + mem-diag build failed. Fix the errors above."
    return 1
  fi
}

stage_build_rp2350w_scheddiag() {
  # Proves the diagnostics firmware compiles + links on the board that
  # compiles the most C behind the PICODROID_SCHED_DIAG define: the kernel's
  # trace/tick hooks, and cyw43_port.c's BUSYDELAY counter, which only a
  # network board builds. Prints the flash cost like the mem-diag leg.
  if ! PICODROID_EXTRA_FEATURES=sched-diag \
       build_board --board testbench_rp2350w --app helloworld; then
    echo ""
    echo "ERROR: rp2350w + sched-diag build failed. Fix the errors above."
    return 1
  fi
}

# Binary-size ratchet. Flash and RAM are the only metrics here with a zero
# noise floor -- the link is deterministic -- and the RP2040 program region is
# the binding budget. Growth is allowed but must be deliberate: advance
# bench/parity/ratchet.toml in the same commit that spends the budget, with a
# "size:" trailer saying why. (docs/perf-campaign-2026-08.md)
#
# Measured into this run's directory and read straight back, so committing
# never touches bench/parity/history.csv. The numbers are, by construction, the
# same as the last commit's unless the image actually changed -- recording them
# would only ever have dirtied the tree. Each lane writes its own subdirectory
# so two concurrent size lanes cannot interleave into one.
size_board() {
  local board="$1"
  if ! PICODROID_BENCH_RECORD=0 PICODROID_PREBUILT_APK="$APK_PATH" \
       PICODROID_PREBUILT_SYSTEM_APKS="$SYSTEM_APK_PATHS" \
       PICODROID_SIZE_RUN_DIR="$RUN_DIR/size/$board" \
       bash "$SCRIPT_DIR/parity-bench.sh" --size-only --boards "$board"; then
    echo ""
    echo "ERROR: size lane failed to build ($board). Fix before committing."
    return 1
  fi
}

stage_size_rp2040() { size_board testbench_rp2040; }
stage_size_rp2350() { size_board testbench_rp2350; }

# Unconditional shrinking's contract (docs/designs/unconditional-shrink-2026-09.md):
# a --shrink firmware spells no original Java class, descriptor or served
# member name anywhere. Link the rp2350 --release --shrink --shrink-app
# helloworld image (its own PAPK: the shared APK_PATH is the no-shrink one)
# and grep it — with --shrink-app the embedded PAPK must not spell the app's
# own package either.
stage_shrink_image() {
  if ! bash "$SCRIPT_DIR/build.sh" --board testbench_rp2350 --app helloworld --release --shrink --shrink-app; then
    echo ""
    echo "ERROR: rp2350 --release --shrink --shrink-app build failed."
    return 1
  fi
  local elf="${CARGO_TARGET_DIR:-$REPO_ROOT/target}/thumbv8m.main-none-eabihf/release/picodroid"
  bash "$SCRIPT_DIR/check-shrunk-image.sh" "$elf" helloworld/
}

stage_ratchet() {
  # Sibling of size/, not a child: a merge directory inside the tree being
  # walked is found by the same `find` that is filling it, and every log gets
  # copied onto itself.
  local merged="$RUN_DIR/size-merged"
  mkdir -p "$merged"
  # cmd_ratchet only checks the boards it finds, so a fast-tier run that
  # measured rp2040 alone gates rp2040 alone rather than erroring out.
  find "$RUN_DIR/size" -mindepth 2 -name '*.size.log' -exec cp {} "$merged/" \;
  if ! compgen -G "$merged/*.size.log" > /dev/null; then
    echo "no size logs produced; nothing to ratchet"
    return 0
  fi
  if ! python3 "$SCRIPT_DIR/bench-report.py" --ratchet --sizes-from "$merged"; then
    echo ""
    echo "ERROR: the image grew past bench/parity/ratchet.toml. If the growth is"
    echo "       intended, accept the run just measured -- a bare --accept reads"
    echo "       bench/parity/history.csv instead, which may be stale:"
    echo "         D=\$(mktemp -d)"
    echo "         PICODROID_SIZE_RUN_DIR=\$D ./scripts/parity-bench.sh --size-only \\"
    echo "           --boards testbench_rp2040,testbench_rp2350"
    echo "         ./scripts/bench-report.py --ratchet --sizes-from \"\$D\" --accept"
    echo "       and commit the new baseline alongside the change, with a"
    echo "       'size: <board> +N B' trailer in the message."
    echo ""
    echo "       NOTE: --accept refuses a run that measured fewer boards than the"
    echo "       baseline holds, so re-measure both boards (or use --full)."
    return 1
  fi
}

# ------------------------------------------------------------------- driver

PROGRESS="$RUN_DIR/progress.log"
: > "$PROGRESS"

emit_progress() {
  # A short append to an O_APPEND fd is already atomic, but lanes finish
  # stages at arbitrary moments and the lock costs nothing.
  if command -v flock >/dev/null 2>&1; then
    { flock 9; printf '%s\n' "$1" >> "$PROGRESS"; } 9>"$RUN_DIR/.progress.lock"
  else
    printf '%s\n' "$1" >> "$PROGRESS"
  fi
}

fmt_dur() { printf '%dm%02ds' $(( $1 / 60 )) $(( $1 % 60 )); }

run_lane() {
  local lane="$1"
  local log="$RUN_DIR/$lane.log"
  local name start dur
  [[ -n "${LANE_TARGET_DIR[$lane]:-}" ]] && export CARGO_TARGET_DIR="${LANE_TARGET_DIR[$lane]}"
  for name in ${LANE_STAGES[$lane]}; do
    start=$SECONDS
    { echo ""; echo "######## $lane :: $name ########"; } >> "$log"
    if ! "stage_$name" >> "$log" 2>&1; then
      dur=$(( SECONDS - start ))
      emit_progress "  ✗ $(fmt_dur "$dur")  ${STAGE_LABEL[$name]}"
      echo "$lane" > "$RUN_DIR/failed-lane"
      return 1
    fi
    dur=$(( SECONDS - start ))
    emit_progress "  ✓ $(fmt_dur "$dur")  ${STAGE_LABEL[$name]}"
  done
}

run_lane_serial() {
  local lane="$1"
  local name start dur
  [[ -n "${LANE_TARGET_DIR[$lane]:-}" ]] && export CARGO_TARGET_DIR="${LANE_TARGET_DIR[$lane]}"
  for name in ${LANE_STAGES[$lane]}; do
    start=$SECONDS
    echo "==> ${STAGE_LABEL[$name]}"
    if ! "stage_$name"; then
      echo "$lane" > "$RUN_DIR/failed-lane"
      return 1
    fi
    dur=$(( SECONDS - start ))
    printf '  ✓ %s  %s\n' "$(fmt_dur "$dur")" "${STAGE_LABEL[$name]}"
  done
  unset CARGO_TARGET_DIR
}

# Kill a lane and everything it started. Lanes share this script's process
# group, so killing the pid alone would orphan a running cargo.
kill_tree() {
  local pid="$1" child
  for child in $(pgrep -P "$pid" 2>/dev/null || true); do
    kill_tree "$child"
  done
  kill -TERM "$pid" 2>/dev/null || true
}

PRINTED=0
flush_progress() {
  local total
  total=$(wc -l < "$PROGRESS")
  if (( total > PRINTED )); then
    sed -n "$((PRINTED + 1)),\$p" "$PROGRESS"
    PRINTED=$total
  fi
}

report_failure() {
  local lane
  lane="$(cat "$RUN_DIR/failed-lane" 2>/dev/null || echo unknown)"
  echo ""
  if [[ -s "$RUN_DIR/$lane.log" ]]; then
    echo "==> FAILED in the '$lane' lane. Its output:"
    echo ""
    cat "$RUN_DIR/$lane.log"
  else
    # Serial lanes stream straight to stdout, so the output is already above.
    echo "==> FAILED in the '$lane' lane (output above)."
  fi
  echo ""
  echo "==> Full logs: $RUN_DIR"
  echo "    Re-run just this lane's checks with: ./scripts/pre-commit --serial"
}

# ------------------------------------------------------------------- output

echo "==> pre-commit (tier: $TIER, lanes: $([[ $SERIAL -eq 1 ]] && echo serial || echo parallel), jobs/lane: $JOBS)"
if [[ "$TIER" == fast ]]; then
  scope=""
  [[ $BUCKET_RUST -eq 1 ]] && scope+=" rust"
  [[ $BUCKET_JVM  -eq 1 ]] && scope+=" java/kotlin"
  [[ $BUCKET_MD   -eq 1 ]] && scope+=" markdown"
  [[ $BUCKET_SCRIPTS -eq 1 ]] && scope+=" scripts"
  echo "    changed:${scope:- (nothing relevant)}    --full adds the release-cut legs"
fi
echo "    $SELECTED_COUNT stage(s)"
echo ""

if [[ $LIST_ONLY -eq 1 ]]; then
  for lane in "${LANE_ORDER[@]}"; do
    [[ -z "${LANE_STAGES[$lane]:-}" ]] && continue
    echo "  [$lane]${LANE_TARGET_DIR[$lane]:+  CARGO_TARGET_DIR=${LANE_TARGET_DIR[$lane]#"$REPO_ROOT"/}}"
    for name in ${LANE_STAGES[$lane]}; do
      echo "      $name — ${STAGE_LABEL[$name]}"
    done
  done
  exit 0
fi

if [[ $SELECTED_COUNT -eq 0 ]]; then
  echo "==> Nothing to check."
  exit 0
fi

START_ALL=$SECONDS

# The prologue is serial on purpose: the guards are seconds long and would only
# add noise, and every cargo lane needs the APK it builds. Run it through the
# quiet path even in parallel mode -- these stages are chatty (test-jvm-env
# alone prints twenty lines) and on a passing run none of it is worth reading.
for lane in guards; do
  [[ -z "${LANE_STAGES[$lane]:-}" ]] && continue
  if [[ $SERIAL -eq 1 ]]; then
    run_lane_serial "$lane" || { report_failure; exit 1; }
  else
    run_lane "$lane" || { flush_progress; report_failure; exit 1; }
    flush_progress
  fi
done

# Everything between the serial prologue and the serial epilogue, in
# LANE_ORDER. Derived rather than listed: a hand-written list silently drops a
# lane added to LANE_ORDER but forgotten here -- its stages are counted,
# reported as selected, and never run (which is what the `qa` lane did on the
# run that added it).
PARALLEL_LANES=()
for lane in "${LANE_ORDER[@]}"; do
  case "$lane" in
    guards|epilogue) continue ;;
  esac
  [[ -n "${LANE_STAGES[$lane]:-}" ]] && PARALLEL_LANES+=("$lane")
done

if [[ ${#PARALLEL_LANES[@]} -gt 0 ]]; then
  if [[ $SERIAL -eq 1 ]]; then
    for lane in "${PARALLEL_LANES[@]}"; do
      if ! run_lane_serial "$lane"; then
        report_failure
        exit 1
      fi
    done
  else
    declare -A LANE_PID=()
    for lane in "${PARALLEL_LANES[@]}"; do
      # set +e so a failing stage still records its status instead of the
      # subshell dying under errexit before it can.
      ( set +e; run_lane "$lane"; echo $? > "$RUN_DIR/$lane.status" ) &
      LANE_PID[$lane]=$!
      echo "  started lane: $lane"
    done
    echo ""

    cleanup_lanes() {
      local l
      for l in "${PARALLEL_LANES[@]}"; do
        kill_tree "${LANE_PID[$l]}" 2>/dev/null || true
      done
    }
    trap 'cleanup_lanes; exit 130' INT TERM

    # Poll for per-lane status files rather than `wait -n`: a status file is
    # unambiguous (kill -0 still succeeds on an unreaped child) and needs no
    # bash 4.3+.
    FAILED=0
    while :; do
      flush_progress
      done_count=0
      for lane in "${PARALLEL_LANES[@]}"; do
        if [[ -f "$RUN_DIR/$lane.status" ]]; then
          done_count=$((done_count + 1))
          [[ "$(cat "$RUN_DIR/$lane.status")" != "0" ]] && FAILED=1
        fi
      done
      [[ $FAILED -eq 1 ]] && break
      [[ $done_count -eq ${#PARALLEL_LANES[@]} ]] && break
      sleep 0.3
    done
    flush_progress

    if [[ $FAILED -eq 1 ]]; then
      cleanup_lanes
      wait 2>/dev/null || true
      trap - INT TERM
      report_failure
      exit 1
    fi
    wait
    trap - INT TERM
  fi
fi

# The epilogue streams: the ratchet prints a baseline-vs-current size table
# that is the point of running it.
for lane in epilogue; do
  [[ -z "${LANE_STAGES[$lane]:-}" ]] && continue
  if ! run_lane_serial "$lane"; then
    report_failure
    exit 1
  fi
done

echo ""
echo "==> All checks passed. ($(fmt_dur $(( SECONDS - START_ALL ))))"
