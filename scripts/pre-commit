#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT_DIR="$REPO_ROOT/scripts"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

echo "==> Checking Java formatting..."
if ! bash "$REPO_ROOT/scripts/format_java.sh" check; then
  exit 1
fi

echo "==> Linting markdown (markdownlint-cli2)..."
if ! bash "$REPO_ROOT/scripts/lint-md.sh"; then
  echo ""
  echo "ERROR: Markdown lint failed. Run './scripts/lint-md.sh --fix' to"
  echo "       auto-fix, or './scripts/lint-md.sh' to see issues."
  echo "       If deps aren't installed yet: run 'npm install' in the repo root."
  exit 1
fi

echo "==> Checking hil-tests.conf against the source tree..."
if ! bash "$REPO_ROOT/scripts/check-hil-conf.sh"; then
  echo ""
  echo "ERROR: hil-tests.conf references apps or log tags that no longer"
  echo "       exist. Update the affected rows (or ALLOW_TAGS in"
  echo "       scripts/check-hil-conf.sh) so the nightly suites don't go"
  echo "       permanently red."
  exit 1
fi

echo "==> Checking for shadow twins across platforms/ and picodroid-core..."
# The extraction moved ~26k LOC out of platforms/rp/src. A move that leaves a
# same-named file behind compiles fine and then silently diverges: commit
# fc896b3 is the precedent, and ESP's removed scaffold accumulated 17 such
# twins before anyone noticed. So: no relative path may exist under both
# trees, except the ones below.
#
# The exceptions are two ends of one seam, not copies:
#   gc_root_registration.rs — one provider list per crate is the design
#                             (docs/designs/shared-core-extraction.md §3.G)
#   hal/mod.rs              — core's is the trait/facade surface, the
#                             family's is the rp-vs-sim routing
#   pdb/mod.rs              — core's is the wire protocol, the family's wires
#                             its four impls into it. Same shape as hal/mod.rs:
#                             one name, two ends of a seam.
#   fs/mod.rs               — core's is LittleFS itself (behind the `littlefs`
#                             feature); the family's picks the backing store
#                             and re-exports. Same shape again.
#
# hal/sim/mod.rs was a third exception until the simulator's last three stubs
# moved to core; the family's copy is gone, so the pair is gone with it.
TWIN_ALLOW='^(gc_root_registration\.rs|hal/mod\.rs|pdb/mod\.rs|fs/mod\.rs)$'
TWINS=$({ comm -12 \
    <(cd "$REPO_ROOT/platforms/rp/src" && find . -name '*.rs' | sed 's|^\./||' | sort) \
    <(cd "$REPO_ROOT/picodroid-core/src" && find . -name '*.rs' | sed 's|^\./||' | sort) \
  | grep -Ev "$TWIN_ALLOW" || true; })
if [[ -n "$TWINS" ]]; then
  echo ""
  echo "ERROR: these paths exist under BOTH platforms/rp/src and"
  echo "       picodroid-core/src:"
  echo "$TWINS" | sed 's/^/         /'
  echo ""
  echo "       A file left behind by a move is a shadow twin: both copies"
  echo "       compile, one is dead, and they drift apart silently. Delete"
  echo "       the stale one. If the pair is genuinely two ends of a seam,"
  echo "       add it to TWIN_ALLOW above with a comment saying why."
  exit 1
fi

echo "==> Checking sim/family-rp cfg-gate hygiene..."
# docs/parity-audit.md BLD-02/X2: sim builds keep `family-rp` ACTIVE (the
# board feature chain), so a gate written as not(feature = "family-rp") does
# NOT mean "not the simulator" — it selects the no-family path. The
# existing occurrences are deliberate cross-family gates; a new one usually
# wants `feature = "sim"` spelled out instead.
#
# Was 4 before the shared-core extraction, now 0. Each of the four picked
# between a real platform capability and a stub — FreeRTOS mutexes vs no-ops
# (monitor_store x2), a debug-bridge stop poll vs `false` (lvgl/calibration,
# then native_handler's `interrupted`). Every one of those is a question the
# RTOS and platform-hook seams now answer, so the gates were deleted rather
# than moved.
#
# The expected count is 0 because that is the end state, not a coincidence:
# a new occurrence is shared code guessing at the platform instead of asking
# it. If one is genuinely right, raise the count here and record it under
# BLD-02 in docs/parity-audit.md.
# `|| true` because the expected count is now 0: grep exits 1 when it matches
# nothing, and under `set -euo pipefail` that would abort the whole script on
# the very state this check is supposed to accept.
FAMRP_GATES=$({ grep -rn 'not(feature = "family-rp")' \
  "$REPO_ROOT/platforms/rp/src" "$REPO_ROOT/picodroid-core/src" || true; } | wc -l | tr -d ' ')
if [[ "$FAMRP_GATES" != "0" ]]; then
  grep -rn 'not(feature = "family-rp")' \
    "$REPO_ROOT/platforms/rp/src" "$REPO_ROOT/picodroid-core/src" || true
  echo ""
  echo "ERROR: expected 0 'not(feature = \"family-rp\")' cfg gates,"
  echo "       found $FAMRP_GATES. Sim builds activate family-rp, so this"
  echo "       pattern does not exclude the simulator. Prefer a HAL/RTOS/host"
  echo "       seam method, or spell the gate feature = \"sim\". If the new"
  echo "       gate is genuinely correct, bump the expected count in"
  echo "       scripts/pre-commit and note it under BLD-02 in"
  echo "       docs/parity-audit.md."
  exit 1
fi

echo "==> Type-checking all Java apps (gradle compileJava)..."
if ! (cd "$REPO_ROOT" && ./gradlew compileJava --console=plain); then
  echo ""
  echo "ERROR: Java compilation failed. Fix the errors above before committing."
  exit 1
fi

echo "==> Checking formatting (cargo fmt)..."
if ! cargo fmt -- --check; then
  echo ""
  echo "ERROR: Formatting check failed. Run 'cargo fmt' to fix, then re-stage your changes."
  exit 1
fi

# Build a representative APK once for all clippy / firmware build checks.
echo "==> Building helloworld APK for type-checking..."
bash "$REPO_ROOT/scripts/build-apk.sh" --app helloworld
APK_PATH="$REPO_ROOT/build/apks/helloworld.papk"

# Run clippy for each board target
JOBS="$(cpu_count)"

# testbench_rp2350w compiles the cyw43/network path and pico_enviro_mon the
# sensor/has_buttons path — neither is reachable from the other boards' cfgs.
# pico_enviro_mon_w is the only board combining both (sensors + network).
for board in testbench_rp2040 testbench_rp2350 testbench_rp2350w pico_enviro_mon pico_enviro_mon_w; do
  resolve_board "$board"
  echo "==> Running clippy ($board)..."
  # shellcheck disable=SC2086
  if ! PICODROID_APK_PATH="$APK_PATH" \
       cargo $CARGO_PLUS clippy \
         --manifest-path "$MANIFEST_DIR/Cargo.toml" \
         -p "$PACKAGE" --jobs "$JOBS" --target "$TARGET" --no-default-features \
         --features "$BOARD_FEATURE" -- --deny=warnings; then
    echo ""
    echo "ERROR: Clippy check failed ($board). Fix the warnings above before committing."
    exit 1
  fi
done

# Staged handle-table-32 arm (audit P1-9): the generational handle table is
# default-off on 32-bit targets until the HIL soak flips it, so without these
# legs its no_std/32-bit arm would be compiled by nothing until flip time.
# Lint both widths; the rp2040 build below also LINKS it (the flash gate).
# Remove these legs when handle-table-32 becomes a default feature.
for board in testbench_rp2040 testbench_rp2350; do
  resolve_board "$board"
  echo "==> Running clippy ($board + handle-table-32)..."
  # shellcheck disable=SC2086
  if ! PICODROID_APK_PATH="$APK_PATH" \
       cargo $CARGO_PLUS clippy \
         --manifest-path "$MANIFEST_DIR/Cargo.toml" \
         -p "$PACKAGE" --jobs "$JOBS" --target "$TARGET" --no-default-features \
         --features "$BOARD_FEATURE,handle-table-32" -- --deny=warnings; then
    echo ""
    echo "ERROR: Clippy check failed ($board + handle-table-32). Fix the warnings above before committing."
    exit 1
  fi
done

echo "==> Building (rp2040 + handle-table-32, staged-arm flash gate)..."
if ! PICODROID_EXTRA_FEATURES=handle-table-32 \
     bash "$REPO_ROOT/scripts/build.sh" --board testbench_rp2040 --app helloworld; then
  echo ""
  echo "ERROR: rp2040 + handle-table-32 build failed. The staged generational"
  echo "       handle table's 32-bit arm no longer compiles/links; fix before"
  echo "       committing (it becomes the default after the HIL soak)."
  exit 1
fi

HOST_TARGET="$(host_target)"

echo "==> Running clippy (sim)..."
# MANIFEST_DIR/PACKAGE/CARGO_PLUS are still set to testbench_rp2350 from the loop above.
# shellcheck disable=SC2086
if ! PICODROID_APK_PATH="$APK_PATH" \
     cargo $CARGO_PLUS clippy \
       --manifest-path "$MANIFEST_DIR/Cargo.toml" \
       -p "$PACKAGE" --jobs "$JOBS" --target "$HOST_TARGET" --no-default-features \
       --features "sim,board-testbench-rp2350" -- --deny=warnings; then
  echo ""
  echo "ERROR: Clippy check failed (sim). Fix the warnings above before committing."
  exit 1
fi

echo "==> Running clippy (sim + mem-diag)..."
# Keeps the opt-in memory diagnostics compiling and warning-clean
# (docs/memory-diagnostics.md); firmware flash budget for mem-diag is
# checked by the rp2350 build below.
# shellcheck disable=SC2086
if ! PICODROID_APK_PATH="$APK_PATH" \
     cargo $CARGO_PLUS clippy \
       --manifest-path "$MANIFEST_DIR/Cargo.toml" \
       -p "$PACKAGE" --jobs "$JOBS" --target "$HOST_TARGET" --no-default-features \
       --features "sim,board-testbench-rp2350,mem-diag" -- --deny=warnings; then
  echo ""
  echo "ERROR: Clippy check failed (sim + mem-diag). Fix the warnings above before committing."
  exit 1
fi

echo "==> Building..."
if ! bash "$REPO_ROOT/scripts/build.sh" --board testbench_rp2040 --app helloworld; then
  echo ""
  echo "ERROR: Build failed. Fix the errors above before committing."
  exit 1
fi

# The --release firmware image is what HIL/CI flashes, and its section sizes
# differ from debug (no LTO now, but a genuine opt profile). RP2040 is the
# flash-constrained target, so link it in release too — this is the lane that
# catches code growth spilling past the 896K program region before CI does.
echo "==> Building (rp2040 --release, flash-gate)..."
if ! bash "$REPO_ROOT/scripts/build.sh" --board testbench_rp2040 --app helloworld --release; then
  echo ""
  echo "ERROR: rp2040 --release build failed (likely the 896K FLASH ceiling)."
  echo "       Shrink code/rodata or the embedded APK before committing."
  exit 1
fi

echo "==> Building (rp2350 + mem-diag)..."
# Proves the diagnostics firmware compiles + links (vPortGetHeapStats FFI,
# thumb atomics discipline) and prints its flash cost. RP2040 + mem-diag is
# a manual opt-in only — it sits ~0.1 KB under the 896K program region.
if ! PICODROID_EXTRA_FEATURES=mem-diag \
     bash "$REPO_ROOT/scripts/build.sh" --board testbench_rp2350 --app helloworld; then
  echo ""
  echo "ERROR: rp2350 + mem-diag build failed. Fix the errors above before committing."
  exit 1
fi

echo "==> Running clippy (host tools)..."
if ! cargo clippy -p pdb -p papk-pack -p papk-info -p class-shrink \
     --all-targets --jobs "$JOBS" --target "$HOST_TARGET" -- --deny=warnings; then
  echo ""
  echo "ERROR: Clippy check failed. Fix the warnings above before committing."
  exit 1
fi

echo "==> Running tests..."
if ! bash "$REPO_ROOT/scripts/test.sh"; then
  echo ""
  echo "ERROR: Tests failed. Fix the failures above before committing."
  exit 1
fi

echo "==> Verifying apply_jvm_env propagation..."
if ! bash "$REPO_ROOT/scripts/test-jvm-env.sh"; then
  echo ""
  echo "ERROR: apply_jvm_env smoke test failed. The [jvm] board.toml parser"
  echo "       in scripts/lib.sh is not propagating values to the right"
  echo "       PICODROID_JVM_* env vars. Fix before committing."
  exit 1
fi

# One behavioral Java lane so a pico-jvm semantics regression is caught
# locally, not first by CI/nightly. langsuite is the widest self-checking
# suite (14 sub-demos, log-token asserted, both shrink modes).
echo "==> Running Java conformance suite (langsuite, sim)..."
if ! bash "$REPO_ROOT/scripts/sim-run.sh" --app langsuite --no-email; then
  echo ""
  echo "ERROR: langsuite failed in sim. A pico-jvm/stdlib behavior regressed;"
  echo "       fix before committing."
  exit 1
fi

echo "==> All checks passed."
