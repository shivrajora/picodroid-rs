# Environment for this app's sim row (lib.sh::app_test_env). A volume of its own: the
# zone the app sets must not leak into the other rows' shared /system/time. No network
# time: a real NTP anchor landing mid-run would be a second TIME_CHANGED and move the
# minute the app is waiting on.
PICODROID_SIM_FS=/tmp/picodroid-qa-bcast-fs.img
PICODROID_SIM_NTP_SERVER=off
