<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ink">#F0EEE6</color>
    <color name="quiet">#8A857C</color>
    <color name="accent">#D97757</color>
    <color name="panel">#1C1A18</color>
    <color name="page">#0F0E0D</color>
    <dimen name="stage_width">200dp</dimen>
    <string name="title">Layout demo</string>
    <string name="count">%d of %s</string>
    <string name="long_line">A line far longer than forty pixels of panel</string>

    <!-- The theme: the framework's widgets take these, and ?attr/ in a layout reads them. -->
    <style name="AppTheme">
        <item name="colorPrimary">@color/accent</item>
        <item name="android:colorBackground">@color/page</item>
        <item name="colorSurface">@color/panel</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/quiet</item>
        <!-- An item of the app's own: only ?attr/ reads it. -->
        <item name="captionSize">20sp</item>
    </style>

    <style name="Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Inherits Caption by its name, as on Android. -->
    <style name="Caption.Large">
        <item name="android:textSize">?attr/captionSize</item>
    </style>
</resources>
