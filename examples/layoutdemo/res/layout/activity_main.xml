<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/title"
        style="@style/Caption.Large"
        android:text="@string/title" />

    <!-- Margins in a LinearLayout keep space clear between the children. -->
    <LinearLayout
        android:id="@+id/spaced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/first"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/accent" />

        <FrameLayout
            android:id="@+id/second"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="9dp"
            android:background="@color/accent" />

        <FrameLayout
            android:id="@+id/third"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/accent" />
    </LinearLayout>

    <!-- A weighted Space pushes its neighbours to the edges, whatever the panel's width. -->
    <LinearLayout
        android:id="@+id/vocab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/left_box"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/accent" />

        <Space
            android:id="@+id/spacer"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/right_box"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/accent" />
    </LinearLayout>

    <!-- Floors and ceilings on content-sized views, and an INVISIBLE view that keeps its room. -->
    <LinearLayout
        android:id="@+id/bounds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/floored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="30dp"
            android:minHeight="12dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/capped"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="40dp"
            android:singleLine="true"
            android:text="@string/long_line" />

        <FrameLayout
            android:id="@+id/ghost"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:visibility="invisible"
            android:background="@color/accent" />

        <FrameLayout
            android:id="@+id/after_ghost"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/accent" />
    </LinearLayout>

    <!-- A column's children sit at the start of the cross axis, as on Android. -->
    <LinearLayout
        android:id="@+id/column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/at_start"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/accent" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/stages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
