<?xml version="1.0" encoding="utf-8"?>
<!-- The same RelativeLayout LayoutDemoActivity builds in code: a caption right of a back
     button and centred on it, a corner pinned by margins, a child centred in the parent,
     one below and left-aligned with the caption, a match_parent child stretched between two
     siblings. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="60dp">

    <FrameLayout
        android:id="@+id/rel_back"
        android:layout_width="48dp"
        android:layout_height="30dp"
        android:layout_alignParentLeft="true"
        android:background="@color/accent" />

    <FrameLayout
        android:id="@+id/rel_caption"
        android:layout_width="60dp"
        android:layout_height="16dp"
        android:layout_toRightOf="@id/rel_back"
        android:layout_centerVertical="true"
        android:background="@color/accent" />

    <FrameLayout
        android:id="@+id/rel_corner"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:layout_marginRight="4dp"
        android:layout_marginBottom="6dp"
        android:background="@color/accent" />

    <FrameLayout
        android:id="@+id/rel_centre"
        android:layout_width="20dp"
        android:layout_height="10dp"
        android:layout_centerInParent="true"
        android:background="@color/accent" />

    <FrameLayout
        android:id="@+id/rel_under"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_below="@id/rel_caption"
        android:layout_alignLeft="@id/rel_caption"
        android:background="@color/accent" />

    <FrameLayout
        android:id="@+id/rel_stretch"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_toRightOf="@id/rel_back"
        android:layout_toLeftOf="@id/rel_corner"
        android:layout_alignParentBottom="true"
        android:background="@color/accent" />
</RelativeLayout>
