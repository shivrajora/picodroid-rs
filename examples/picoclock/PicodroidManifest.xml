<?xml version="1.0" encoding="utf-8"?>
<manifest package="picoclock" version="1.0">
    <application application="picoclock/ClockApp" label="Clock">
        <!-- The service is declared so the boot receiver may start it; the receivers are
             Android's alarm-clock pair: one the alarms deliver to, one the framework runs at
             boot and on a clock or zone set while the app is not running. The screens stay
             undeclared (the short form's rule: nothing declared, nothing checked). -->
        <service name=".AlarmService"/>
        <receiver name=".AlarmReceiver"/>
        <receiver name=".BootReceiver">
            <intent-filter>
                <action name="android.intent.action.BOOT_COMPLETED"/>
                <action name="android.intent.action.TIME_SET"/>
                <action name="android.intent.action.TIMEZONE_CHANGED"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Every screen is laid out in pixels against the EP-0172's panel (ui/Ui.java). On any
         other board the runtime shows the app in a 320x480 window: centred on a larger panel,
         panned on a smaller one. -->
    <supports-screens design-width="320" design-height="480" />
</manifest>
