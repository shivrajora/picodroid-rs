<?xml version="1.0" encoding="utf-8"?>
<manifest package="picoclock" version="1.0">
    <!-- The Android-shaped form (docs/designs/manifest-components-2026-10.md): the Application,
         every screen (the clock face's MAIN filter makes it the entry, which ClockApp starts once
         the alarm service is up), the service, and Android's alarm-clock pair of receivers: one
         the alarms deliver to, one the framework runs at boot and on a clock or zone set while
         the app is not running. Each screen's android:label is the title its app bar shows. -->
    <application application="picoclock/ClockApp" label="Clock">
        <activity android:name=".ui.ClockActivity" android:label="Clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AlarmListActivity" android:label="Alarms" />
        <activity android:name=".ui.AlarmEditActivity" android:label="Alarm" />
        <activity android:name=".ui.SetTimeActivity" android:label="Set time" />
        <activity android:name=".ui.RingActivity" android:label="Alarm" />
        <service android:name=".AlarmService" />
        <receiver android:name=".AlarmReceiver" />
        <receiver android:name=".BootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Every screen is designed against the EP-0172's 320x480 panel. On any other board the
         runtime shows the app in a 320x480 window: centred on a larger panel, panned on a
         smaller one. -->
    <supports-screens design-width="320" design-height="480" />
</manifest>
