<?xml version="1.0" encoding="utf-8"?>
<manifest package="appbardemo" version="1.0">
    <!-- Each screen's android:label is the title its app bar shows. -->
    <application label="App bar demo">
        <activity android:name=".MainActivity" android:label="Inbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DraftActivity" android:label="Draft" />
    </application>
</manifest>
