# Environment for this app's test rows (lib.sh::app_test_env): sim-run sets it
# when it runs the app, hil-run when it builds the firmware.
#
# The nightly wants "nothing to talk to": with no bridge at 127.0.0.1 the first
# fetch is refused and the app must classify that. A live bridge on the same
# PC would answer the app's discovery broadcast and turn that row into a real
# sync, so the sim's UDP sockets are denied broadcast here (the app then logs
# "discovery: failed" and falls back to the build-time host, which is also the
# path a client-isolating access point forces on a real device).
PICODROID_SIM_NET_BROADCAST=0
#
# Its own filesystem image, too: the default one is the developer's, and an
# address a live-bridge session cached there (bridge_found) would be tried
# instead of 127.0.0.1. Discovery never writes this one, since it never succeeds.
PICODROID_SIM_FS=/tmp/picodroid-sim/claudeusage-nightly-fs.img
